{{#if resume.publications.length}}
<div class="container publications-container">
  {{> title value="Links"}}

  {{#each resume.publications}}
  <section class="item">
    <a href="{{url}}" target="_new">{{name}}</a>

    {{#if summary}}
      <p class="summary">{{summary}}</p>
    {{/if}}

  </section>
  {{/each}}
</div>
{{/if}}
